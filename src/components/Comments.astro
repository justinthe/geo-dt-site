---
import { site, type Lang } from '../config/site';
import { t } from '../lib/content';
interface Props { lang: Lang; term: string }
const { lang, term } = Astro.props;
const g = site.giscus;
---
{g.repoId && g.categoryId && (
  <section class="comments" aria-labelledby="comments">
    <h2 id="comments" class="collar" style="margin:0 0 .5rem">{t(lang, 'comments')}</h2>
    <p class="note">{t(lang, 'comments.note')}</p>
    <div class="comments-slot" data-giscus={JSON.stringify({ ...g, term, lang })}></div>
  </section>
)}
<script>
  // Giscus loads only when the comments come into view (FR-11). One thread per translationKey, shared by both languages.
  const slot = document.querySelector<HTMLElement>('[data-giscus]');
  const theme = () => (document.documentElement.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark' ? 'dark' : 'light';
  if (slot) {
    const c = JSON.parse(slot.dataset.giscus!);
    new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      const s = document.createElement('script');
      Object.entries({
        src: 'https://giscus.app/client.js', 'data-repo': c.repo, 'data-repo-id': c.repoId, 'data-category': c.category,
        'data-category-id': c.categoryId, 'data-mapping': 'specific', 'data-term': c.term, 'data-reactions-enabled': '1',
        'data-input-position': 'top', 'data-theme': theme(), 'data-lang': c.lang, 'data-loading': 'lazy', crossorigin: 'anonymous',
      }).forEach(([k, v]) => s.setAttribute(k, v));
      s.async = true;
      slot.append(s);
    }, { rootMargin: '400px' }).observe(slot);
    addEventListener('themechange', () => {
      document.querySelector<HTMLIFrameElement>('iframe.giscus-frame')?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
    });
  }
</script>
