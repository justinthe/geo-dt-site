---
// Retired list and sector-filter pages: stubs that send old links to the Geospatial AI page.
import Redirect from '../../../components/Redirect.astro';
import { langs, url, categoryName } from '../../../lib/content';
import { sectors, caseStudyCategory } from '../../../config/site';

export function getStaticPaths() {
  return langs.flatMap((lang) =>
    [undefined, ...Object.keys(sectors)].map((s) => ({ params: { lang, filter: s && `sector/${s}` }, props: { lang } })));
}
const { lang } = Astro.props;
---
<Redirect to={url(`${lang}/${caseStudyCategory}`)} lang={lang} label={categoryName(caseStudyCategory, lang)} />
