---
// Retired list and sector-filter pages: stubs that send old links to the Work page.
import Redirect from '../../../components/Redirect.astro';
import { langs, url } from '../../../lib/content';
import { sectors, navGroups } from '../../../config/site';

export function getStaticPaths() {
  return langs.flatMap((lang) =>
    [undefined, ...Object.keys(sectors)].map((s) => ({ params: { lang, filter: s && `sector/${s}` }, props: { lang } })));
}
const { lang } = Astro.props;
---
<Redirect to={url(`${lang}/work`)} lang={lang} label={navGroups.work.name[lang]} />
